PORT=3000
NODE_ENV=development
# Oturum cerezi imzalama anahtari - canlida mutlaka uzun ve rastgele bir deger verin
SESSION_SECRET=buraya-uzun-rastgele-bir-anahtar-yazin
# Sigara kurali (saat). 4 = 4 saatte bir.
COOLDOWN_HOURS=4
# GUN DEGISIMI ARTIK SAATE BAGLI DEGIL.
# Is gunu, yonetici Gun Sonu Raporu'nu ALANA kadar surer; raporun alindigi
# an donem kapanir ve yeni gun tam o an baslar (Rapor > "Gunu Kapat ve
# Raporu Al"). Ayar gerektirmez.
#
# Asagidaki eski ayar SADECE mevcut kurulumlar icin anlamlidir: ilk
# calistirmada gecmis kayitlar bu saate gore kapanis kayitlarina cevrilir
# (bir kez calisir). Yeni kurulumlarda hicbir etkisi yoktur, silebilirsiniz.
DAY_START_HOUR=6

# --- Otomatik yedekleme ---
# Kac saatte bir veritabani yedegi alinsin. 0 = kapali.
BACKUP_INTERVAL_HOURS=6
# Kac yedek saklansin; fazlasi en eskiden silinir (6 saat x 28 ~ 1 hafta).
BACKUP_KEEP=28
# Yedek klasoru (varsayilan: proje icinde backups/)
# BACKUP_DIR=D:\yedekler\sigara
